{
  "task": "yield regression (target: `yield`, source units, crop-specific; fitted on log1p)",
  "split": {
    "strategy": "temporal, Kaggle rows only: train <= 2014, validation 2015-2017, test > 2017",
    "real_train": 14406,
    "real_validation": 3104,
    "real_test": 2179,
    "synthetic_train_1x": 14406,
    "synthetic_train_2x": 28812,
    "synthetic_test": 4000,
    "seed": 42
  },
  "synthetic_generator": {
    "version": "v2 (train-only templates)",
    "rules": [
      "Templates are drawn ONLY from the rows passed in (the training split): no validation/test row or label can influence a synthetic row.",
      "A synthetic row keeps its template's crop, state and season (no new crop-state pairs); its year is drawn inside the observed [min, max] year range of that crop-state-season group, so it never extrapolates beyond the training window.",
      "Yield is the template yield scaled by the per-crop log-yield time trend estimated from the training rows (slope clipped to +-3%/year) times log-normal noise (sigma 0.12); it is clipped to [0.8 x crop minimum, 1.2 x crop maximum] of the training rows.",
      "Area gets log-normal noise (sigma 0.20); fertilizer and pesticide per hectare share one log-normal factor (sigma 0.15, inputs scale together) plus individual noise (sigma 0.10); production = yield x area, so the record is internally consistent.",
      "Soil (state constants) and weather (state-year aggregate) are the REAL values for the chosen state/year, so weather is never invented.",
      "Rows whose (log area, log yield, fertilizer/ha, pesticide/ha) lie within 0.05 standard deviations of ANY real row of the same group, and rows duplicating another synthetic row, are rejected and regenerated.",
      "Target values are never an input to another feature: yield is generated from the template yield and the year trend only."
    ]
  },
